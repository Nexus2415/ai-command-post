{
  "buildCommand": "",
  "outputDirectory": "dashboard",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 12 * * *"
    }
  ],
  "redirects": [
    {
      "source": "/",
      "destination": "/home.html",
      "permanent": false
    }
  ]
}
