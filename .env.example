# Copy to .env (never commit it). Everything is off and dry-run by default.

# --- Safety switches ---
ACP_ACTIVE=false               # kill switch: false = read and report only, no model calls
ACP_DRY_RUN=true               # true = log Linear/GitHub writes instead of making them
ACP_MONTHLY_BUDGET_USD=0       # hard cap; 0 = free tiers only (today: Gemini)
# ACP_LEDGER_RESET=2026-10     # owner only: lets a lost spend ledger restart at $0 for that month
ACP_ALLOW_PULL_REQUESTS=false  # agents may open DRAFT PRs when true; merging is never possible

# --- Workspace ---
ACP_LINEAR_TEAM_KEY=ARN
ACP_DEFAULT_LEAD=claude        # used when a command title names no AI
ACP_GITHUB_REPOS=              # comma-separated owner/name list agents may read, e.g. Nexus2415/opsdesk-harmony
ACP_POLL_SECONDS=120
ACP_MAX_STEPS=6

# --- Workspace storage (Phase 1): the Command Post's OWN Supabase project, never Arnexyia's ---
# Website server only (Vercel env vars). The service key must never reach the browser.
ACP_WORKSPACE_DB_URL=           # https://<project-ref>.supabase.co
ACP_WORKSPACE_DB_KEY=           # that project's service_role key
ACP_WORKSPACE_MONTHLY_BUDGET_USD=0   # workspace chat cap per month; 0 = no paid replies (separate from the engine's cap)
ACP_WORKSPACE_THREAD_BUDGET_USD=1    # cap per thread, over its whole life
# Workspace plugins switch on when their key is set in Vercel: LINEAR_API_KEY (Linear), GITHUB_TOKEN plus
# ACP_GITHUB_REPOS (GitHub), FIRECRAWL_API_KEY (web search). All read-only.

# --- Keys (leave blank to keep that agent or tool offline) ---
LINEAR_API_KEY=
GITHUB_TOKEN=                  # fine-grained, read-only contents to start
FIRECRAWL_API_KEY=
# Read-only Vercel access for vercel.* tools (list deployments, check status). Deploys are never run.
VERCEL_API_KEY=
GEMINI_API_KEY=                # Google AI Studio free tier
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# --- Model ids (verify against each provider's current docs) ---
ACP_MODEL_CLAUDE=claude-sonnet-5-5
ACP_MODEL_CHATGPT=gpt-5-mini
ACP_MODEL_GEMINI=gemini-2.5-flash
ACP_MODEL_PERPLEXITY=sonar
